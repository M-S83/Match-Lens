    "limitation_notes": {
      "shape": "Visible zone only \u2014 shape readable near ball; far-side structure and full formation not confirmed",
      "spacing": "Visible zone only \u2014 spacing readable between in-frame players; far-side spacing not observable",
      "territory": "Zone readable when ball is clearly in attacking or defending third; mid-pitch gradations approximate",
      "rest_defence": "Immediate transition response visible when ball is lost near camera; far-end defensive recovery not confirmed",
      "opposition_structure": "Near-ball structure readable; full opposition shape requires wide coverage",
      "player_role": "In-zone role observable; off-ball positioning habits when out of frame not confirmable",
      "phase": "Phase readable in visible zone; full-team phase transitions not confirmed",
      "pressing": "Near-ball press visible and scoreable; far-side press triggers and cover shadows not confirmed",
      "build_up": "Build-up observable when in frame; full team build-up shape limited by coverage",
      "transitions": "Transitions visible when occurring near camera; far-end transitions not observed",
      "set_pieces": "Set piece structure readable \u2014 most players cluster in small area; deliveries and outcomes confirmable"
    }
