# Secrets — never commit these
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# OS noise
.DS_Store
Thumbs.db

# Binaries / large files (backstop)
*.mp4
*.mov
*.zip
*.tar.gz

# Match output directories
matches/
output/
*_output/

# Editor
.vscode/
.idea/
*.swp

# Parent skill manifest — belongs in skill workflow, not this repo
../SKILL.md

# Exemplar style templates — local only, may contain real match data
exemplars/

# Validation harness
# Quarantined ground-truth DATA — one-way valve. Regenerable via the extractor
# (statsbomb_groundtruth.py, which IS versioned). Never committed to the pipeline repo.
validation/groundtruth/*.json
ground_truth_*.json
# Generated result artifacts — keep the dir, not its contents
validation/outputs/*
!validation/outputs/.gitkeep
!validation/groundtruth/.gitkeep
